from fastapi import FastAPI
import whisperx
import gc
import torch
import psycopg2
from psycopg2 import pool
import boto3
import json
import os
import tempfile
import time
import threading
from urllib.parse import urlparse
from whisperx.diarize import DiarizationPipeline
from speechbrain.inference.speaker import EncoderClassifier
import torch.nn.functional as F
from pymilvus import connections, Collection, MilvusClient
import uvicorn
# At the very top of app.py
import warnings
warnings.filterwarnings("ignore", category=UserWarning)
import os
from dotenv import load_dotenv

load_dotenv(override=True)
app = FastAPI()

# ============================================================
# POSTGRES CONFIG
# ============================================================

DB_CONFIG = {
    "dbname": os.getenv("DB_NAME"),
    "user": os.getenv("USER"),
    "password": os.getenv("PASSWORD"),
    "host": os.getenv("HOST"),
    "port": os.getenv("PORT")
}


# ============================================================
# POSTGRES CONNECTION POOL (FASTER)
# ============================================================

connection_pool = psycopg2.pool.SimpleConnectionPool(
    1,
    10,
    **DB_CONFIG
)

# ============================================================
# S3 CLIENT
# ============================================================

s3 = boto3.client(
    "s3",
    region_name=os.getenv("REGION_NAME")
)

# ============================================================
# LOAD MODELS ONCE
# ============================================================
device = "cuda" if torch.cuda.is_available() else "cpu"
print("Using device:", device)
hf_token = os.getenv("hf_token")

asr_options = {
    "repetition_penalty": 1.2,
    "condition_on_previous_text": False,
    "no_speech_threshold": 0.6,
    "compression_ratio_threshold": 2.4
}

vad_options = {
    "vad_onset": 0.500,
    "vad_offset": 0.363
}

print("Loading WhisperX model...")

model = whisperx.load_model(
    "medium",
    device,
    compute_type="float16",
    language="en",
    asr_options=asr_options,
    vad_options=vad_options
)

print("Loading alignment model...")

model_a, metadata = whisperx.load_align_model(
    language_code="en",
    device=device
)

print("Loading diarization model...")

diarize_model = DiarizationPipeline(
    use_auth_token=hf_token,
    device=device
)

classifier = EncoderClassifier.from_hparams(
    source="speechbrain/spkrec-ecapa-voxceleb",
    run_opts={"device": device}
)
classifier.to(device)
#connections.connect(alias="default", host="milvus", port="19530")
#connections.connect(host="host.docker.internal", port="19530")
client = MilvusClient(uri="http://milvusprod.indiabonds.com:19530",token="root:Milvus")
client.load_collection("agent_voice_embeddings")

# ============================================================
# DOWNLOAD SINGLE AUDIO
# ============================================================

def download_audio(call_id, s3_link):

    parsed_url = urlparse(s3_link)

    if s3_link.startswith("s3://"):
        bucket_name = parsed_url.netloc
        s3_key = parsed_url.path.lstrip("/")    
    else:
        bucket_name = parsed_url.netloc.split(".")[0]
        s3_key = parsed_url.path.lstrip("/")

    temp_audio_path = os.path.join(
        tempfile.gettempdir(),
        f"{call_id}.wav"
    )

    s3.download_file(bucket_name, s3_key, temp_audio_path)

    return temp_audio_path

# ============================================================
# TRANSCRIPTION FUNCTION
# ============================================================

def process_call(call_id):

    conn = connection_pool.getconn()
    cur = conn.cursor()

    try: 

        # ===============================
        # FETCH CALL DATA
        # ===============================
        cur.execute("""
            SELECT agent_id, s3_file_path
            FROM call_records_test
            WHERE source_pbx_call_id = %s
        """, (call_id,))

        row = cur.fetchone()

        if not row:
            return

        caller_number, s3_link = row

        # ===============================
        # IDENTIFY AGENT FROM PHONE
        # ===============================  
        cur.execute("""
            SELECT agent_name
            FROM agents_numbers
            WHERE phone_number = %s
        """, (caller_number,))

        agent_row = cur.fetchone()

        user_name = agent_row[0] if agent_row else "Unknown"

        # ===============================
        # DOWNLOAD AUDIO
        # ===============================
        audio_path = download_audio(call_id, s3_link)
        print("STEP 2 - Audio downloaded")


        audio = whisperx.load_audio(audio_path)
        print("STEP 3 - Audio loaded")


        # ===============================
        # TRANSCRIBE AUDIO
        # ===============================
        result = model.transcribe(audio, batch_size=32, language="en")
        print("STEP 4 - Transcription finished")


        # ===============================
        # ALIGN WORDS
        # ===============================
        result = whisperx.align(
            result["segments"],
            model_a,
            metadata,
            audio,
            device
        )
        print("STEP 5 - Alignment finished")


        # ===============================
        # DIARIZATION
        # ===============================
        diarize_segments = diarize_model(
            audio,
            min_speakers=2,
            max_speakers=2
        )
        print("STEP 6 - Diarization finished")

        result = whisperx.assign_word_speakers(
            diarize_segments,
            result
        )

        # ===============================
        # GROUP AUDIO BY SPEAKER
        # ===============================
        speaker_audio = {
            "SPEAKER_00": [],
            "SPEAKER_01": []
        }

        #audio_tensor = torch.from_numpy(audio).float().unsqueeze(0)
        audio_tensor = torch.from_numpy(audio).float().unsqueeze(0).to(device)

        for seg in result["segments"]:

            speaker = seg.get("speaker")

            if speaker not in speaker_audio:
                continue

            start = int(seg["start"] * 16000)
            end = int(seg["end"] * 16000)

            snippet = audio_tensor[:, start:end]

            if snippet.shape[1] < 1600:
                continue

            speaker_audio[speaker].append(snippet)

        # ===============================
        # CREATE SPEAKER EMBEDDINGS
        # ===============================
        speaker_embeddings = {}

        for speaker, snippets in speaker_audio.items():

            embeddings = []

            for snippet in snippets:
                snippet = snippet.to(device)

                with torch.no_grad():

                    emb = classifier.encode_batch(snippet).squeeze()
                    emb = F.normalize(emb, dim=0)

                embeddings.append(emb)

            if len(embeddings) > 0:

                speaker_embeddings[speaker] = F.normalize(
                    torch.stack(embeddings).mean(dim=0),
                    dim=0
                )
        # ===============================
        # LOAD AGENT EMBEDDINGS
        # ===============================
        results = client.query(
            collection_name="agent_voice_embeddings",
            filter=f'agent_name == "{user_name}"',
            output_fields=["embedding"])

        agent_embeddings = torch.tensor(
            [r["embedding"] for r in results],
            dtype=torch.float32,
            device=device)

        agent_centroid = F.normalize(
            agent_embeddings.mean(dim=0),
            dim=0
        )

        # ===============================
        # IDENTIFY AGENT SPEAKER
        # ===============================
        best_speaker = None
        best_score = -1

        for speaker, emb in speaker_embeddings.items():

            similarity = F.cosine_similarity(
                agent_centroid,
                emb,
                dim=0
            ).item()

            if similarity > best_score:
                best_score = similarity
                best_speaker = speaker

        if best_score < 0.70:
            real_agent_id = None
        else:
            real_agent_id = best_speaker

        # ===============================
        # BUILD FINAL TRANSCRIPT
        # ===============================
        final_transcript = []

        for segment in result["segments"]:

            spk = segment.get("speaker", "UNKNOWN")

            if spk == real_agent_id:
                role = "Agent"
            else:
                role = "Customer"

            final_transcript.append(
                f"[{role}]: {segment['text'].strip()}"
            )

        # ===============================
        # STORE IN DATABASE
        # ===============================
        cur.execute("""
            INSERT INTO call_audio (
                call_audio_id,
                user_name,
                audio_path,
                call_recording_link,
                transcribed_text
            )
            VALUES (%s,%s,%s,%s,%s)
        """, (
            call_id,
            user_name,
            audio_path,
            s3_link,
            "\n".join(final_transcript)
        ))

        conn.commit()

        print(f"Finished call {call_id} | Agent similarity: {best_score:.3f}")

    except Exception as e:

        conn.rollback()
        print("Error processing call:", e)

    finally:

        cur.close()
        connection_pool.putconn(conn)

# ============================================================
# BACKGROUND WORKER
# ============================================================

def background_worker():

    while True:

        conn = connection_pool.getconn()
        cur = conn.cursor()

        cur.execute("""
            SELECT w.source_pbx_call_id
            FROM call_records_test w
            LEFT JOIN call_audio c
            ON w.source_pbx_call_id = c.call_audio_id
            WHERE c.call_audio_id IS NULL
            ORDER BY w.source_pbx_call_id
            LIMIT 1
        """)

        rows = cur.fetchall()

        if rows:
            print(f"Found {len(rows)} new calls")

        for row in rows:

            call_id = row[0]

            print("Processing call:", call_id)

            process_call(call_id)

        cur.close()
        connection_pool.putconn(conn)

        time.sleep(10)

# ============================================================
# START WORKER WHEN API STARTS
# ============================================================

@app.on_event("startup")
def start_worker():

    thread = threading.Thread(target=background_worker)
    thread.daemon = True
    thread.start()

# ============================================================
# RUN SERVER
# ============================================================

if __name__ == "__main__":
    uvicorn.run("app:app", host="0.0.0.0", port=8000)
